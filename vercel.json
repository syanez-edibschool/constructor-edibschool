{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/tools.ts":            { "maxDuration": 120 },
    "api/analysis.ts":         { "maxDuration": 300 },
    "api/coach/message.ts":    { "maxDuration": 60 },
    "api/coach/voice.ts":      { "maxDuration": 120 },
    "api/suggest-answer.ts":   { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/projects/:projectId/generate-nicho-avatar-competencia", "destination": "/api/analysis?operation=generate" },
    { "source": "/api/projects/:projectId/update-nicho",        "destination": "/api/analysis?operation=update-nicho" },
    { "source": "/api/projects/:projectId/update-avatar",       "destination": "/api/analysis?operation=update-avatar" },
    { "source": "/api/projects/:projectId/update-competencia",  "destination": "/api/analysis?operation=update-competencia" },
    { "source": "/api/projects/:projectId/tools/:toolId",       "destination": "/api/tools" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
